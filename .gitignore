# ==============================================================================
# Ministry of Ayush & AIIA CTMS - Comprehensive Git Ignore Rules
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg
*.egg-info/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
bin/
var/
sdist/

# SQLite & Local Databases
*.db
*.sqlite
*.sqlite3

# Pytest, Coverage & Benchmarking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Uploaded Clinical Documents (Preserve folder structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/

# NPM & Yarn Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Vercel Deployment Metadata
.vercel/

# Environment Variables & Credentials (Keep .env.example tracked)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Operating System & IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
